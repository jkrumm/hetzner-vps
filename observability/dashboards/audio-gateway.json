        },
        "source": "Traces",
        "sqlTemplate": "SELECT p.Model AS Model, count() AS Chunks, round(quantile(0.5)(c.Duration) / 1e6) AS p50_wall_ms, round(quantile(0.95)(c.Duration) / 1e6) AS p95_wall_ms, round(quantile(0.95)(toFloat64OrZero(c.SpanAttributes['replicate.predict_time_s'])) * 1000) AS p95_compute_ms, round(quantile(0.95)(c.Duration / 1e6 - toFloat64OrZero(c.SpanAttributes['replicate.predict_time_s']) * 1000)) AS p95_overhead_ms, round(avg(toFloat64OrZero(c.SpanAttributes['replicate.polls'])), 1) AS avg_polls FROM $__sourceTable AS c INNER JOIN (SELECT TraceId, SpanAttributes['audio.model'] AS Model FROM $__sourceTable WHERE $__timeFilter(Timestamp) AND ServiceName = 'audio-gateway' AND SpanName = 'audio.speech') AS p ON c.TraceId = p.TraceId WHERE $__timeFilter(c.Timestamp) AND c.ServiceName = 'audio-gateway' AND c.SpanName = 'audio.synth.chunk' AND $__filters GROUP BY Model ORDER BY Chunks DESC LIMIT 20"
      },
