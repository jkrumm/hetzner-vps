          },
          "type": "search",
          "whereLanguage": "sql",
          "whereTemplate": "ServiceName = 'audio-gateway' AND SpanAttributes['audio.model'] = '{{Model}}'"
        },
        "source": "Traces",
        "sqlTemplate": "SELECT concat(SpanAttributes['audio.lane'], '/', SpanAttributes['audio.mode']) AS Profile, SpanAttributes['audio.model'] AS Model, count() AS Requests, round(quantile(0.5)(Duration) / 1e6) AS p50_ms, round(quantile(0.95)(Duration) / 1e6) AS p95_ms, round(quantile(0.95)(Duration / 1e9 / nullIf(toFloat64OrZero(SpanAttributes['audio.audio_seconds']), 0)), 2) AS p95_rtf, round(median(toFloat64OrZero(SpanAttributes['audio.input_chars']))) AS med_chars, round(median(toFloat64OrZero(SpanAttributes['audio.audio_seconds'])), 1) AS med_audio_s, round(sum(toFloat64OrZero(SpanAttributes['audio.input_chars'])) / nullIf(sum(toFloat64OrZero(SpanAttributes['audio.audio_seconds'])), 0), 1) AS chars_per_audio_s, round(100 * countIf(toFloat64OrZero(SpanAttributes['audio.chunks']) > 1) / count()) AS multi_chunk_pct, round(sum(toFloat64OrZero(SpanAttributes['audio.cost_usd'])), 4) AS cost_usd, round(sum(toFloat64OrZero(SpanAttributes['audio.cost_usd'])) / nullIf(sumIf(toFloat64OrZero(SpanAttributes['audio.audio_seconds']), SpanAttributes['audio.cost_source'] = 'estimated'), 0), 5) AS usd_per_audio_s FROM $__sourceTable WHERE $__timeFilter(Timestamp) AND ServiceName = 'audio-gateway' AND SpanName = 'audio.speech' AND $__filters GROUP BY Profile, Model ORDER BY Requests DESC LIMIT 20"
      },
      "containerId": "tts",
      "h": 5,
      "id": "6a8fffab09140756bb26a369",
      "name": "TTS profiles \u2014 per lane/mode/model: requests, wall p50/p95 (ms), p95 real-time factor (compute s per audio s), chars, audio s, multi-chunk share, USD, USD per audio s \u2014 click a row to search its spans",
