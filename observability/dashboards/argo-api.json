    },
    {
      "config": {
        "configType": "sql",
        "connection": "Local ClickHouse",
        "displayType": "line",
        "fillNulls": true,
        "source": "Traces",
        "sqlTemplate": "SELECT $__timeInterval(Timestamp) AS ts, SpanAttributes['http.route'] AS Route, round(quantile(0.95)(Duration) / 1e6) AS p95_ms FROM $__sourceTable WHERE $__timeFilter(Timestamp) AND ServiceName = 'argo-api' AND SpanKind = 'Server' AND $__filters AND SpanAttributes['http.route'] IN (SELECT SpanAttributes['http.route'] FROM $__sourceTable WHERE $__timeFilter(Timestamp) AND ServiceName = 'argo-api' AND SpanKind = 'Server' AND SpanAttributes['http.route'] != '' GROUP BY 1 ORDER BY count() DESC LIMIT 8) GROUP BY ts, Route ORDER BY ts LIMIT 5000"
      },
      "containerId": "routes",
      "h": 6,
      "id": "6a8ff0df09140756bb267093",
      "name": "p95 latency by route (ms) \u2014 8 busiest routes",
      "w": 12,
      "x": 12,
      "y": 3
    },
    {
      "config": {
        "configType": "sql",
        "connection": "Local ClickHouse",
        "displayType": "table",
        "onClick": {
          "target": {
            "mode": "id",
            "source": "Traces"
          },
          "type": "search",
          "whereLanguage": "sql",
          "whereTemplate": "ServiceName = 'argo-api' AND SpanKind = 'Server' AND SpanAttributes['http.request.method'] = '{{Method}}' AND SpanAttributes['http.route'] = '{{Route}}'"
        },
        "source": "Traces",
        "sqlTemplate": "SELECT SpanAttributes['http.request.method'] AS Method, SpanAttributes['http.route'] AS Route, count() AS Requests, countIf(StatusCode = 'Error' OR SpanAttributes['http.response.status_code'] >= '500') AS Errors, round(quantile(0.5)(Duration) / 1e6) AS p50_ms, round(quantile(0.95)(Duration) / 1e6) AS p95_ms FROM $__sourceTable WHERE $__timeFilter(Timestamp) AND ServiceName = 'argo-api' AND SpanKind = 'Server' AND SpanAttributes['http.route'] != '' AND $__filters GROUP BY Method, Route HAVING Requests >= 3 ORDER BY p95_ms DESC LIMIT 30"
      },
      "containerId": "routes",
      "h": 8,
      "id": "6a8ff0df09140756bb267094",
      "name": "Slowest routes (\u2265 3 requests) \u2014 p50/p95 ms, requests, errors",
      "w": 24,
      "x": 0,
      "y": 9
    },
    {
      "config": {
        "configType": "sql",
        "connection": "Local ClickHouse",
        "displayType": "table",
        "source": "Traces",
        "sqlTemplate": "SELECT if(SpanAttributes['db.system'] != '', concat('postgres ', SpanName), SpanAttributes['server.address']) AS Dependency, count() AS Calls, countIf(StatusCode = 'Error' OR SpanAttributes['http.response.status_code'] >= '400') AS Errors, round(quantile(0.5)(Duration) / 1e6) AS p50_ms, round(quantile(0.95)(Duration) / 1e6) AS p95_ms FROM $__sourceTable WHERE $__timeFilter(Timestamp) AND ServiceName = 'argo-api' AND SpanKind = 'Client' AND $__filters GROUP BY Dependency ORDER BY Calls DESC LIMIT 25"
      },
